# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Model used to read simple, single-component sub-drawings (title block +
# spec block + callouts). Cheap and accurate enough for this.
GEMINI_MODEL=gemini-3.5-flash-lite

# Model used for (a) reading the dense multi-view GAD sheet, and (b) the
# cross-referencing comparison step -- both benefit from stronger reasoning.
GEMINI_COMPLEX_MODEL=gemini-3.5-flash

# DPI used to rasterize PDF pages before sending to Gemini.
RENDER_DPI=300

# Max tokens Gemini is allowed to spend on ONE response's JSON output.
GEMINI_MAX_OUTPUT_TOKENS=65536

# Windows only: if poppler's bin folder isn't on PATH, set this explicitly.
# POPPLER_PATH=C:\poppler\Library\bin

# Used only to estimate cost at the end of each run.
INPUT_COST_PER_MTOK=0.75
OUTPUT_COST_PER_MTOK=4.50

# ---------------------------------------------------------------------------
# App / API
# ---------------------------------------------------------------------------
# Any SQLAlchemy URL works. Defaults to a local SQLite file so the app runs
# with zero extra setup. This project uses MySQL (driver: PyMySQL), e.g.:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/drawing_validator
DATABASE_URL=sqlite:///./drawing_validator.db

# Directory (relative to project root) where uploaded PDFs and rendered
# page images are stored while a job runs.
UPLOAD_DIR=uploads

# Upload size limit per file, in MB.
MAX_FILE_MB=20

# Comma-separated list of origins allowed to call the API from a browser.
# Use "*" to allow any origin (fine for local/dev use).
CORS_ORIGINS=*

# Set to "true" to auto-create tables on startup instead of relying solely
# on Alembic migrations. Handy for local dev; leave "false" in production
# and run `alembic upgrade head` as part of your deploy instead.
AUTO_CREATE_TABLES=true

# Host/port the app binds to when started via startup.py
APP_HOST=0.0.0.0
APP_PORT=8000
